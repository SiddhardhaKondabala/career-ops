{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "career-ops/schemas/application-result.v1.schema.json",
  "title": "Application Result (v1)",
  "description": "One durable record per job attempt, written by the execution engine and imported back into the career-ops tracker. Personal data; never committed to a tracked path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executor_run_id",
    "integration_id",
    "canonical_url",
    "started_at",
    "finished_at",
    "result",
    "confidence",
    "company",
    "role",
    "career_ops_score",
    "resume_path",
    "cover_letter_path",
    "screenshot_paths",
    "questions_encountered",
    "fields_filled",
    "error_code",
    "error_message",
    "manual_action_required"
  ],
  "properties": {
    "schema": { "const": "application-result.v1" },
    "executor_run_id": { "type": "string" },
    "integration_id": { "type": "string" },
    "canonical_url": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "result": {
      "type": "string",
      "enum": [
        "submitted",
        "already_applied",
        "manual_review",
        "captcha",
        "requires_mfa",
        "failed",
        "skipped",
        "expired",
        "invalid"
      ]
    },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "company": { "type": "string" },
    "role": { "type": "string" },
    "career_ops_score": { "type": "number" },
    "resume_path": { "type": "string" },
    "cover_letter_path": { "type": ["string", "null"] },
    "screenshot_paths": { "type": "array", "items": { "type": "string" } },
    "questions_encountered": { "type": "array" },
    "fields_filled": { "type": "array" },
    "error_code": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "manual_action_required": { "type": "boolean" },
    "resume_sha256": { "type": ["string", "null"] },
    "cover_letter_sha256": { "type": ["string", "null"] }
  }
}
